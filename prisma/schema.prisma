datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  email            String          @unique
  passwordHash     String
  role             String          @default("user")
  name             String?
  jobTitle         String?
  bio              String?
  avatarUrl        String?
  twoFactorEnabled Boolean?        @default(false)
  tokenBalance     Int             @default(100)
  organizationId   String?         @db.ObjectId
  organization     Organization?   @relation(fields: [organizationId], references: [id])
  settings         UserSettings?
  apiTokens        ApiToken[]
  workflows        Workflow[]
  refreshToken     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime?       @default(now()) @updatedAt
  modelConfigs     ModelConfig[]
  llmConnections   LlmConnection[]
  toolConnections  ToolConnection[]
}

model Agent {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  schema      Json
  version     String   @default("1.0.0")
  createdAt   DateTime @default(now())
}

/// Per-user LLM provider configuration (API keys, endpoints, default model).
/// Stored in MongoDB — one record per (userId, providerId) pair.
model ModelConfig {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String    @db.ObjectId
  user       User      @relation(fields: [userId], references: [id])
  /// Provider identifier: 'groq' | 'gemini' | 'ollama' | 'openai' | 'lm-studio'
  providerId String
  /// API key — stored as base64-encoded string for basic obfuscation
  apiKey     String?
  /// Custom base URL (Ollama host, Azure OpenAI endpoint, LM Studio URL)
  baseUrl    String?
  /// Default model ID override for this provider
  modelId    String?
  /// Whether this provider is active
  isEnabled  Boolean   @default(true)
  /// Whether this provider is the platform-wide default for this user
  isDefault  Boolean   @default(false)
  /// Timestamp of the last successful/failed connection test
  lastTested DateTime?
  /// Test result: 'ok' | 'error' | 'pending' | null
  testStatus String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, providerId])
}

/// Dedicated LLM Connection model storing provider endpoints, loaded/available models,
/// credentials, and connection health.
/// Stored in MongoDB in the `llmConnection` collection.
model LlmConnection {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  user            User      @relation(fields: [userId], references: [id])
  /// Provider identifier: 'lm-studio' | 'groq' | 'gemini' | 'ollama' | 'openai'
  providerId      String
  /// Friendly display name, e.g. "LM Studio (127.0.0.1:1234)"
  name            String?
  /// API key — stored as base64-encoded string
  apiKey          String?
  /// Custom base URL (e.g. 'http://127.0.0.1:1234/v1')
  baseUrl         String?
  /// Selected active/default model ID (e.g. 'google/gemma-3-4b')
  modelId         String?
  /// Synced/available models loaded from provider (JSON list of models)
  availableModels Json?
  /// Whether this connection is enabled
  isEnabled       Boolean   @default(true)
  /// Whether this connection is the platform default
  isDefault       Boolean   @default(false)
  /// Timestamp of the last successful/failed connection test
  lastTested      DateTime?
  /// Test result: 'ok' | 'error' | 'pending' | null
  testStatus      String?
  /// Measured round-trip latency in milliseconds
  latencyMs       Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, providerId])
  @@map("llmConnection")
}

model Workflow {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workflowId  String   @unique   // frontend wf-xxx ID
  name        String
  description String?  @default("")
  nodes       Json     @default("[]")
  edges       Json     @default("[]")
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("workflow")
}

model Organization {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String   @unique
  website   String?
  industry  String?
  logoUrl   String?
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organization")
}

model UserSettings {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  userId               String   @unique @db.ObjectId
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Execution Defaults (Cloud vs Local dual execution)
  defaultExecutionMode String   @default("cloud") // "cloud" | "local"
  defaultModelId       String   @default("google/gemini-2.5-flash")
  temperature          Float    @default(0.7)
  maxTokens            Int      @default(2048)
  // Notifications
  automationFailures   Boolean  @default(true)
  weeklyDigest         Boolean  @default(true)
  agentErrorAlerts     Boolean  @default(true)
  billingReminders     Boolean  @default(false)
  newFeatures          Boolean  @default(false)
  teamActivity         Boolean  @default(true)
  emailDigestFrequency String   @default("weekly")
  webhookUrl           String?
  // Appearance & Canvas
  theme                String   @default("Light")
  sidebarDefault       String   @default("Expanded")
  canvasGridStyle      String   @default("dots") // "dots" | "lines" | "cross"
  interfaceDensity     String   @default("comfortable") // "comfortable" | "compact"
  soundEffects         Boolean  @default(true)
  // Region & Language
  timezone             String   @default("UTC+05:30 – Mumbai, New Delhi")
  language             String   @default("English (US)")
  dateFormat           String   @default("MM/DD/YYYY")
  currency             String   @default("USD ($)")
  // Telemetry & Privacy
  telemetryEnabled     Boolean  @default(true)
  crashReportsEnabled  Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("userSettings")
}

model ApiToken {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  tokenPrefix String
  tokenHash   String
  scopes      String[]  @default(["all"])
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("apiToken")
}

model ToolConnection {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String    @db.ObjectId
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolId     String    // 'github', 'slack', 'google-sheets', 'exa', etc.
  name       String?
  type       String?   @default("Agent App") // "Agent App" | "MCP" | "LLM Provider"
  token      String?   // base64 encoded
  apiKey     String?   // base64 encoded
  config     Json?     // custom parameters like repoOwner, repoName, orgId
  status     String    @default("Configured")
  lastTested DateTime?
  latencyMs  Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, toolId])
  @@map("toolConnection")
}

