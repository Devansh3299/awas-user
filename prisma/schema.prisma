datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String
  role         String   @default("user")
  createdAt    DateTime @default(now())
}

model Agent {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  schema      Json
  version     String   @default("1.0.0")
  createdAt   DateTime @default(now())
}
